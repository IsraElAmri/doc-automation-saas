# Environment Variable Template for Production / Staging
# Rename this file to .env and populate with real secrets.

# Server & Security
ENVIRONMENT=production
SECRET_KEY=replace-with-a-secure-random-64-char-string
ADMIN_TOKEN=replace-with-a-secure-admin-token-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_FORMAT=json

# Database
# POSTGRES_PASSWORD is used by docker-compose for the db container and as the
# password component of the DB_URL default inside the compose environment: block.
POSTGRES_PASSWORD=replace-with-a-secure-postgres-password

# DB_URL is injected automatically by docker-compose (environment: block in compose.yml).
# DO NOT uncomment this line when using Docker Compose — setting it here would override
# the compose default and point the container at localhost instead of the db service,
# breaking the database connection on a fresh clone.
# Uncomment ONLY for local runs without Docker (replace password and host as needed):
# DB_URL=postgresql://postgres:replace-with-a-secure-postgres-password@localhost:5432/doc_automation

# Google Gemini AI API (production chat/extraction engine)
GEMINI_API_KEY=replace-with-your-actual-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Groq API (evaluation harness only — not used in production)
GROQ_API_KEY=replace-with-your-actual-groq-api-key

# Optional Error Tracking (Sentry)
SENTRY_DSN=
